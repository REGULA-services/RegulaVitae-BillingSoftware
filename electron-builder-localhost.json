{
  "appId": "com.madrasorthoclinic.localhost",
  "productName": "MADRAS ORTHO CLINIC LOCALHOST",
  "npmRebuild": false,
  "icon": "build/icon.ico",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-electron/**/*",
    "dist/**/*",
    "public/**/*",
    "build/icon.ico",
    "package.json"
  ],
  "extraMetadata": {
    "name": "madras-ortho-clinic-localhost",
    "productName": "MADRAS ORTHO CLINIC LOCALHOST",
    "main": "dist-electron/src/main/main-localhost.js"
  },
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icon.ico",
    "executableName": "MADRAS ORTHO CLINIC LOCALHOST"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "runAfterFinish": true,
    "include": "build/installer.nsh",
    "artifactName": "MADRAS ORTHO CLINIC LOCALHOST Setup ${version}.${ext}"
  }
}
