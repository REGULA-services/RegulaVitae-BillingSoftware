{
  "name": "madras-ortho-clinic-software",
  "version": "1.0.0",
  "description": "MADRAS ORTHO CLINIC SOFTWARE - Mission for Cure - Pharmacy Billing POS System",
  "author": "MADRAS ORTHO CLINIC",
  "main": "dist-electron/src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:server": "nodemon --watch src/server --exec ts-node --project tsconfig.electron.json src/server/server.ts",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "tsc -p tsconfig.renderer.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:vite && npm run build:electron",
    "package": "npm run build && electron-builder",
    "package:localhost": "npm run build && electron-builder --config electron-builder-localhost.json",
    "package:msix": "npm run build && electron-builder --win appx",
    "package:msi": "npm run build && electron-builder --win msi",
    "start": "node dist-server/server.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@types/qrcode": "^1.5.6",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "jimp": "^1.6.1",
    "lucide-react": "^0.372.0",
    "nodemon": "^3.1.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.3",
    "to-ico": "^1.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.madrasorthoclinic.pos",
    "productName": "MADRAS ORTHO CLINIC SOFTWARE",
    "npmRebuild": false,
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "public/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "appx": {
      "applicationId": "MadrasOrthoClinicSoftware",
      "identityName": "MadrasOrthoClinic.MadrasOrthoClinicSoftware",
      "publisherDisplayName": "MADRAS ORTHO CLINIC",
      "publisher": "CN=MadrasOrthoClinic",
      "backgroundColor": "#0ea5e9",
      "artifactName": "${productName} ${version}.msix"
    }
  }
}
