{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/main/**/*",
    "src/server/**/*"
  ],
  "exclude": [
    "node_modules",
    "android",
    "scratch",
    "dist",
    "dist-electron"
  ]
}
